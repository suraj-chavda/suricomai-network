{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuriComAI",
  "version": "0.1.0",
  "identifier": "network.suricomai.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true,
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "../isolation"
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SuriComAI",
    "copyright": "Copyright (c) 2026 SuriComAI. All rights reserved.",
    "category": "DeveloperTool",
    "shortDescription": "SuriComAI Network desktop app (development build)",
    "longDescription": "Desktop window for the SuriComAI local node. Development build: answers are not private, and there is no wallet, payment or token. Proprietary software; use requires the owner's written permission.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}
